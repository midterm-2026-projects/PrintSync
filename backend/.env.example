# Supabase Postgres connection (recommended)
# Get from Supabase: Project Settings -> Database -> Connection string
SUPABASE_DB_URL=

# Optional: set to 'disable' ONLY for local/dev setups
SUPABASE_DB_SSLMODE=require

# Optional pool tuning
PG_POOL_MAX=10

# Fallback (if you don't want SUPABASE_DB_URL)
# PGHOST=
# PGPORT=5432
# PGDATABASE=
# PGUSER=
# PGPASSWORD=

GEMINI_API_KEY=
