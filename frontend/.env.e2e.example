# E2E tests deliberately require a disposable or dedicated test database.
# Never point this to production data.
E2E_RUN=true
E2E_DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE

# Alternative for a deliberately approved local backend/.env database:
# E2E_USE_BACKEND_ENV=true

# Optional: use an already-running deployment instead of starting local Vite/Express.
# E2E_BASE_URL=http://127.0.0.1:5173
